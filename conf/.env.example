# -----------------------------------------------------------------------------
# Application database connection settings
# These values are consumed by docker compose when it creates the PostgreSQL
# service. They control the initial database/user/password inside the container
# and the host port published on your machine.
# These are passed into the backend and Python services through env_file.
# They are used by the code to connect to the PostgreSQL service over the
# internal Docker network, so DB_HOST should usually stay "postgres".
# -----------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=postgres
DB_NAME=ems-db
DB_PORT=5432

# -----------------------------------------------------------------------------
# Configure port and ip-address for backend service
# These values are used by docker compose for port mapping on the host.
# Change port if 3001 is already in use on your machine.
# The ip-address must be the one of the machine where EMS4DC is hosted on; try 
# 'ipconfig' or 'ifconfig' in terminal to find the IP-address of the machine.
# The port in VITE_BASE_URL must be the same as in BACKEND_PORT.
# -----------------------------------------------------------------------------
BACKEND_PORT=3001
VITE_BASE_URL=http://12.345.678.901:3001

# -----------------------------------------------------------------------------
# Configure port and ip-address for frontend service
# These values are used by docker compose for port mapping on the host.
# Change port if 5173 is already in use on your machine.
# The ip-address must be the one of the machine where EMS4DC is hosted on; try 
# 'ipconfig' or 'ifconfig' in terminal to find the IP-address of the machine.
# The port in FRONTEND_IP must be the same as in FRONTEND_PORT.
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173
FRONTEND_IP=http://12.345.678.901:5173

# -----------------------------------------------------------------------------
# Configure port for modbus-api service
# This value is used by docker compose for port mapping on the host.
# Change port if 5051 is already in use on your machine.
# The port in MODBUS_API_URL must be the same as in MODBUS_API_PORT.
# -----------------------------------------------------------------------------
MODBUS_API_PORT=5051
MODBUS_API_URL=http://py-modbus-api:5051

# -----------------------------------------------------------------------------
# Proxy settings used at image build time
# Leave blank if your network does not require a proxy.
# -----------------------------------------------------------------------------
HTTP_PROXY=http://proxy.example.com:8080
HTTPS_PROXY=http://proxy.example.com:8080

# -----------------------------------------------------------------------------
# Runtime application settings
# -----------------------------------------------------------------------------
SESSION_SECRET=some_random_very_long_secret_!!!

# -----------------------------------------------------------------------------
# Timezone must be specified for proper timestamp display.
# Use an IANA timezone name such as:
#   Europe/Berlin
#   Europe/Lisbon   (Portugal)
#   Asia/Almaty     (Kazakhstan)
# -----------------------------------------------------------------------------
TIMEZONE=Europe/Berlin